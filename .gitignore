# --- Segurança e Variáveis de Ambiente ---
# Bloqueia o arquivo de chaves real. Nunca suba o .env original!
.env
.env*.local
.env.test.local
.env.production.local
.env.development.local

# --- Dependências ---
node_modules/
jspm_packages/

# --- Build e Outputs ---
dist/
dist-ssr/
*.com
*.class
*.dll
*.exe
*.o
*.so

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Supabase (Específico para sua estrutura) ---
